---
import { LINKS, SECTIONS } from '../consts';
import { formatDate, type Post } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { data } = post;
const section = SECTIONS[data.section];
const canonical = 'canonical' in data ? data.canonical : undefined;
const devto = 'crosspost' in data ? data.crosspost?.devto : undefined;
---

<Base
	title={data.title}
	description={data.description}
	canonical={canonical}
	type="article"
	publishedTime={data.pubDate}
	modifiedTime={data.updatedDate}
	noindex={data.draft}
>
	<article class="post">
		<header>
			<p class="muted small">
				<a href={`/${data.section}/`}>{section.label}</a>
				{'series' in data && data.series && <> · {data.series}</>}
			</p>
			<h1>{data.title}</h1>
			<p class="muted small">
				<time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
				{
					data.updatedDate && (
						<>
							{' '}
							· updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
						</>
					)
				}
				{data.draft && <span class="badge">draft</span>}
			</p>
		</header>
		<div class="prose">
			<slot />
		</div>
		<footer class="post-footer muted small">
			{canonical && (
				<p>
					Originally published at <a href={canonical}>{new URL(canonical).hostname}</a>.
				</p>
			)}
			{devto && (
				<p>
					Also on <a href={devto}>dev.to</a>, if you want to comment there.
				</p>
			)}
			<p>
				Subscribe to <a href={`/${data.section}/rss.xml`}>{section.label} via RSS</a> or write to me at{' '}
				<a href={`mailto:${LINKS.email}`}>{LINKS.email}</a>.
			</p>
		</footer>
	</article>
</Base>
