---
import Base from '../layouts/Base.astro';

const contributions = [
	{
		repo: 'docker/compose',
		title: 'Simplify flag conversion with a switch',
		url: 'https://github.com/docker/compose/pull/9507',
	},
	{
		repo: 'mui/material-ui',
		title: 'Fix the import example in the Unstyled Backdrop docs',
		url: 'https://github.com/mui/material-ui/pull/30098',
	},
];
---

<Base title="Projects" description="Side projects and open-source contributions by Thanos Theodosiou.">
	<h1>Projects</h1>

	<article class="story">
		<h2><a href="https://github.com/TheodosiouTh/kotsu.nvim">kotsu.nvim</a></h2>
		<p>
			A Neovim plugin that answers "how do I…" with key sequences. Run <code>:Kotsu</code>, ask how to do something,
			and get the fastest way to do it, grounded in your own keymaps. I'm building it in public; follow along in the
			<a href="/devlogs/">devlogs</a>.
		</p>
	</article>

	<h2>Open source</h2>
	<ul class="post-list">
		{
			contributions.map((c) => (
				<li>
					<a href={c.url}>{c.title}</a>
					<span class="muted meta">{c.repo}</span>
				</li>
			))
		}
	</ul>
</Base>
